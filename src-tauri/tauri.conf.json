{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENViewer",
  "mainBinaryName": "enviewer",
  "version": "0.2.3",
  "identifier": "app.lumen.viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ENViewer",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 500,
        "backgroundColor": "#141416",
        "dragDropEnabled": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' lumen: http://lumen.localhost blob: data:; media-src 'self' lumen: http://lumen.localhost http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost lumen: http://lumen.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "M. Estiaque Ahmed Khan",
    "category": "Photography",
    "shortDescription": "Fast, premium image viewer and photo browser",
    "longDescription": "ENViewer is a fast, offline image viewer and photo browser with HEIC, RAW and Live Photo support.",
    "copyright": "© 2026 M. Estiaque Ahmed Khan · MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "jpe",
          "jfif"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/jpeg"
      },
      {
        "ext": [
          "png"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "apng"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/apng"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/gif"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/webp"
      },
      {
        "ext": [
          "bmp",
          "dib"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/bmp"
      },
      {
        "ext": [
          "ico"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/vnd.microsoft.icon"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/tiff"
      },
      {
        "ext": [
          "svg"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/svg+xml"
      },
      {
        "ext": [
          "svgz"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/svg+xml-compressed"
      },
      {
        "ext": [
          "avif"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/avif"
      },
      {
        "ext": [
          "heic"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/heic"
      },
      {
        "ext": [
          "heif",
          "hif"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/heif"
      },
      {
        "ext": [
          "jxl"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/jxl"
      },
      {
        "ext": [
          "psd"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/vnd.adobe.photoshop"
      },
      {
        "ext": [
          "hdr"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
