        "role": "Viewer",
        "mimeType": "image/x-tga"
      },
      {
        "ext": [
          "qoi"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/qoi"
      },
      {
        "ext": [
          "pbm",
          "pgm",
          "ppm",
          "pnm",
          "pam"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/x-portable-anymap"
      },
      {
        "ext": [
          "dng"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-adobe-dng"
      },
      {
        "ext": [
          "cr2"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-canon-cr2"
      },
      {
        "ext": [
          "cr3"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-canon-cr3"
      },
      {
        "ext": [
          "crw"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-canon-crw"
      },
      {
        "ext": [
          "nef",
          "nrw"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-nikon-nef"
      },
      {
        "ext": [
          "arw",
          "srf",
          "sr2"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-sony-arw"
      },
      {
        "ext": [
          "raf"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-fuji-raf"
      },
      {
        "ext": [
          "orf"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-olympus-orf"
      },
      {
        "ext": [
          "rw2"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-panasonic-rw2"
      },
      {
        "ext": [
          "pef"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-pentax-pef"
      },
      {
        "ext": [
          "srw"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW file",
        "role": "Viewer",
        "mimeType": "image/x-samsung-srw"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libheif1",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ],
        "section": "graphics",
        "desktopTemplate": "enviewer.desktop",
        "conflicts": [
          "lumen"
        ],
        "replaces": [
          "lumen"
        ],
        "provides": [
          "lumen"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "desktopTemplate": "enviewer.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "homepage": "https://mestiaque.com"
  }
}
